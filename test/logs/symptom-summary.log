2026-06-08 23:29:42 - INFO - Summary generated successfully | summary='High-risk newborn assessment protocol involving weight measurement, malformation screening, and evaluation for respiratory distress, severe jaundice, and poor feeding.' | core_symptoms=['respiratory rate >60 bpm', 'severe subcostal retractions', 'yellow staining within 24 h', 'yellow staining on palms/soles', 'poor sucking', 'weak cry', 'birth weight <2000 g'] | secondary_symptoms=['non-passage of meconium at 24 h', 'non-passage of urine at 48 h', 'major malformations', 'neural tube defects', 'oesophageal atresia', 'anal atresia', 'diaphragmatic hernia'] | severe_symptoms=[] | tags=['newborn care', 'high-risk infant', 'respiratory distress', 'severe jaundice', 'birth weight', 'malformation screening', 'neonatal assessment']
